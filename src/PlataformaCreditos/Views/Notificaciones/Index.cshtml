@model List<PlataformaCreditos.Models.Notificacion>

@{
    ViewData["Title"] = "Mis notificaciones";
}

<div class="page-header">
    <h1>Mis notificaciones</h1>
    <p>Confirmaciones entregadas por la cola de mensajes, con acuse de recibo.</p>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="empty-icono">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </span>
        <h5>No tienes notificaciones todavía</h5>
        <p class="mb-3">Cuando registres una solicitud, recibirás aquí la confirmación de la cola.</p>
        <a asp-controller="Solicitudes" asp-action="Crear" class="btn btn-primary">Crear una solicitud</a>
    </div>
}
else
{
    @foreach (var n in Model)
    {
        <div class="notificacion-item">
            <span class="notificacion-icono">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </span>
            <div class="notificacion-cuerpo">
                <p>@n.Texto</p>
                <div class="notificacion-meta">
                    <span>Solicitud <a asp-controller="Solicitudes" asp-action="Detalle" asp-route-id="@n.SolicitudId"><strong>#@n.SolicitudId</strong></a></span>
                    <span>Procesada: @n.FechaProcesamientoUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC</span>
                    <span>MessageId: <code>@n.MessageId</code></span>
                </div>
            </div>
        </div>
    }
}
