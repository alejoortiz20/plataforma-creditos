@model List<PlataformaCreditos.Models.SolicitudCredito>
@{
    ViewData["Title"] = "Panel de analista";
}

<div class="page-header">
    <h1>Panel de analista</h1>
    <p>Solicitudes de crédito pendientes de evaluación.</p>
</div>

@if (TempData["ExitoAnalista"] is string exito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @exito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorAnalista"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card card-hover">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="feature-icono mb-0">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
                <div>
                    <div class="text-muted small">Pendientes</div>
                    <div style="font-size:1.6rem;font-weight:700;">@Model.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-hover">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="feature-icono mb-0">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </span>
                <div>
                    <div class="text-muted small">Monto total en cola</div>
                    <div style="font-size:1.6rem;font-weight:700;">@Model.Sum(s => s.MontoSolicitado).ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-hover">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="feature-icono mb-0">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <div>
                    <div class="text-muted small">Clientes distintos</div>
                    <div style="font-size:1.6rem;font-weight:700;">@Model.Select(s => s.ClienteId).Distinct().Count()</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <span class="empty-icono">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <h5>Todo al día</h5>
        <p class="mb-0">No hay solicitudes pendientes de evaluación.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Cliente</th>
                    <th>Monto solicitado</th>
                    <th>Ingresos mensuales</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><strong>#@s.Id</strong></td>
                        <td>@(s.Cliente?.Usuario?.UserName ?? s.Cliente?.UsuarioId ?? "-")</td>
                        <td>@s.MontoSolicitado.ToString("C")</td>
                        <td>@(s.Cliente != null ? s.Cliente.IngresosMensuales.ToString("C") : "-")</td>
                        <td>@s.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal"
                                        data-bs-target="#aprobar-@s.Id">Aprobar</button>
                                <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                        data-bs-target="#rechazar-@s.Id">Rechazar</button>
                            </div>
                        </td>
                    </tr>

                    <div class="modal fade" id="aprobar-@s.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form asp-controller="Analista" asp-action="Aprobar" asp-route-id="@s.Id" method="post" class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                        Aprobar solicitud #@s.Id
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p>¿Confirmas la aprobación de la solicitud por <strong>@s.MontoSolicitado.ToString("C")</strong>?</p>
                                    @if (!PlataformaCreditos.Models.ReglasCredito.EsAprobable(s.MontoSolicitado, s.Cliente!.IngresosMensuales))
                                    {
                                        <div class="alert alert-warning mb-0">
                                            El monto supera 5 veces los ingresos del cliente; no se podrá aprobar.
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-success">Confirmar aprobación</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="modal fade" id="rechazar-@s.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form asp-controller="Analista" asp-action="Rechazar" asp-route-id="@s.Id" method="post" class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        Rechazar solicitud #@s.Id
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <label class="form-label" for="motivo-@s.Id">Motivo de rechazo (obligatorio)</label>
                                    <textarea id="motivo-@s.Id" name="motivo" class="form-control" rows="3" required placeholder="Ej. Documentación incompleta del cliente"></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-danger">Confirmar rechazo</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
}
