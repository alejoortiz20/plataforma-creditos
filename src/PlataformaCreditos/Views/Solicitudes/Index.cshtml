@model PlataformaCreditos.Models.ViewModels.SolicitudesViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

<h1>Mis solicitudes</h1>

<p>
    Conexión en tiempo real: <span id="wss-estado" class="badge text-bg-secondary">Conectando…</span>
</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <p class="mb-0">No se pudieron aplicar los filtros. Se muestran todas tus solicitudes:</p>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<PlataformaCreditos.Models.EstadoSolicitud>()">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="MontoMinimo" class="form-label"></label>
            <input asp-for="MontoMinimo" class="form-control" asp-format="{0:N2}" />
            <span asp-validation-for="MontoMinimo" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="MontoMaximo" class="form-label"></label>
            <input asp-for="MontoMaximo" class="form-control" asp-format="{0:N2}" />
            <span asp-validation-for="MontoMaximo" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="FechaDesde" class="form-label"></label>
            <input asp-for="FechaDesde" class="form-control" type="date" />
            <span asp-validation-for="FechaDesde" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="FechaHasta" class="form-label"></label>
            <input asp-for="FechaHasta" class="form-control" type="date" />
            <span asp-validation-for="FechaHasta" class="text-danger"></span>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

@if (Model.Solicitudes.Count == 0)
{
    <p class="text-muted">No tienes solicitudes registradas.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Código</th>
                <th>Monto solicitado</th>
                <th>Fecha de solicitud</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model.Solicitudes)
            {
                <tr data-solicitud-id="@solicitud.Id">
                    <td>@solicitud.Id</td>
                    <td>@solicitud.MontoSolicitado.ToString("C")</td>
                    <td>@solicitud.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge @(solicitud.Estado switch
                        {
                            PlataformaCreditos.Models.EstadoSolicitud.Aprobado => "text-bg-success",
                            PlataformaCreditos.Models.EstadoSolicitud.Rechazado => "text-bg-danger",
                            _ => "text-bg-secondary"
                        })">@solicitud.Estado</span>
                        @if (!string.IsNullOrEmpty(solicitud.MotivoRechazo))
                        {
                            <div data-motivo class="small text-danger">@solicitud.MotivoRechazo</div>
                        }
                    </td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Total: @Model.Solicitudes.Count</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificacionesWss" />
}